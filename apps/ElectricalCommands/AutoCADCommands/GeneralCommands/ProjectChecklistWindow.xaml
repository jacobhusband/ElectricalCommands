<Window x:Class="ElectricalCommands.ProjectChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACIES Project Checklists"
        Height="780" Width="720"
        MinHeight="480" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="#F8F9FA">

  <Window.Resources>
    <!-- Modern Button Style -->
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#CCCCCC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#222222"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="#EAECEF"/>
                <Setter TargetName="border" Property="BorderBrush" Value="#0066CC"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="#D0D7DE"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Danger Button Style -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#C0392B"/>
      <Setter Property="BorderBrush" Value="#F5B7B1"/>
      <Setter Property="Background" Value="#FDEDEC"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FADBD8"/>
          <Setter Property="BorderBrush" Value="#E74C3C"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Custom Progress Bar -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Foreground" Value="#2ECC71"/>
      <Setter Property="Background" Value="#E0E0E0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
              <Grid x:Name="PART_Track">
                <Rectangle x:Name="PART_Indicator"
                           HorizontalAlignment="Left"
                           Fill="{TemplateBinding Foreground}"
                           RadiusX="5" RadiusY="5"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <!-- Header -->
      <RowDefinition Height="Auto"/>
      <!-- Controls Toolbar -->
      <RowDefinition Height="Auto"/>
      <!-- Progress Bar Area -->
      <RowDefinition Height="Auto"/>
      <!-- Checklist Items -->
      <RowDefinition Height="*"/>
      <!-- Footer Status & Actions -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 1. Header Section -->
    <Border Grid.Row="0"
            Background="#FFFFFF"
            BorderBrush="#E1E4E8"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14,10"
            Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Project Checklist"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#1B2A4A"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="📁 Folder: "
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#586069"/>
            <TextBlock x:Name="FolderPathTextBlock"
                       Text="C:\Projects\..."
                       FontSize="11"
                       Foreground="#0366D6"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="450"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </StackPanel>
        </StackPanel>

        <!-- Active DWG Badge -->
        <Border Grid.Column="1"
                Background="#F1F8FF"
                BorderBrush="#C8E1FF"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,4"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Active DWG: " FontSize="11" Foreground="#0366D6"/>
            <TextBlock x:Name="DwgNameTextBlock"
                       Text="E01.00 Power.dwg"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#0366D6"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 2. Controls Toolbar -->
    <Border Grid.Row="1"
            Background="#FFFFFF"
            BorderBrush="#E1E4E8"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,10"
            Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Checklist Selector Dropdown -->
        <ComboBox Grid.Row="0" Grid.Column="0"
                  x:Name="ChecklistComboBox"
                  Height="32"
                  FontSize="13"
                  FontWeight="SemiBold"
                  SelectionChanged="ChecklistComboBox_SelectionChanged"
                  VerticalContentAlignment="Center"
                  Margin="0,0,10,0"/>

        <!-- Reset Button -->
        <Button Grid.Row="0" Grid.Column="1"
                x:Name="ResetChecklistButton"
                Content="Reset Checklist"
                Style="{StaticResource DangerButtonStyle}"
                Click="ResetChecklistButton_Click"
                ToolTip="Uncheck all items in the current checklist"/>

        <!-- Search & Filter Row -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Search Box -->
          <Grid Grid.Column="0" Margin="0,0,12,0">
            <TextBox x:Name="SearchTextBox"
                     Height="28"
                     Padding="6,4,24,4"
                     FontSize="12"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"/>
            <TextBlock x:Name="SearchPlaceholder"
                       Text="🔍 Search items in this checklist..."
                       Foreground="#999999"
                       FontSize="12"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
            <Button x:Name="ClearSearchButton"
                    Content="✕"
                    Width="20" Height="20"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="#888888"
                    Visibility="Collapsed"
                    Click="ClearSearchButton_Click"/>
          </Grid>

          <!-- Hide Completed Toggle -->
          <CheckBox Grid.Column="1"
                    x:Name="HideCompletedCheckBox"
                    Content="Hide completed"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Checked="HideCompletedCheckBox_Changed"
                    Unchecked="HideCompletedCheckBox_Changed"/>
        </Grid>
      </Grid>
    </Border>

    <!-- 3. Progress Bar Area -->
    <Border Grid.Row="2"
            Background="#FFFFFF"
            BorderBrush="#E1E4E8"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,8"
            Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
          <TextBlock x:Name="ProgressLabel"
                     Text="Progress: 0 / 0 completed (0%)"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#24292E"/>
          <TextBlock x:Name="VisibleCountLabel"
                     Text=""
                     FontSize="11"
                     Foreground="#6A737D"
                     HorizontalAlignment="Right"/>
        </Grid>

        <ProgressBar Grid.Row="1"
                     x:Name="ChecklistProgressBar"
                     Value="0"
                     Maximum="100"/>
      </Grid>
    </Border>

    <!-- 4. Checklist Items View -->
    <Border Grid.Row="3"
            Background="#FFFFFF"
            BorderBrush="#E1E4E8"
            BorderThickness="1"
            CornerRadius="6"
            Padding="4"
            ClipToBounds="True">
      <ScrollViewer x:Name="ItemsScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ItemsContainer" Margin="8,4">
          <!-- Dynamically populated rows -->
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 5. Footer Actions & Status -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Auto-save Status Indicator -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="StatusIcon"
                   Text="✔"
                   FontSize="12"
                   Foreground="#28A745"
                   Margin="0,0,6,0"/>
        <TextBlock x:Name="StatusTextBlock"
                   Text="Checklist state saved to folder."
                   FontSize="11"
                   Foreground="#586069"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Action Buttons -->
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="ReloadButton"
                Content="Reload"
                Width="85"
                Click="ReloadButton_Click"
                ToolTip="Reload checklist state from disk"/>
        <Button Content="Close"
                Width="85"
                Margin="8,0,0,0"
                Click="CloseButton_Click"
                IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
