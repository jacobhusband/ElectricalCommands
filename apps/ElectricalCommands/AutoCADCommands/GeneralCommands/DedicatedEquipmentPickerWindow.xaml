<Window x:Class="ElectricalCommands.DedicatedEquipmentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RC - Dedicated Circuit"
        Width="920"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F5F7F9"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="12,5"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Dedicated circuit equipment"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#1F2933"/>
      <TextBlock Text="Filter and use a preset, maintain the preset list, or enter a one-time circuit without saving it."
                 Margin="0,4,0,0"
                 Foreground="#52606D"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="White"
              BorderBrush="#D9E0E7"
              BorderThickness="1"
              CornerRadius="5"
              Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Search presets"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="SearchTextBox"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Search descriptions, aliases, voltage, load, poles, or breaker size"/>
          </StackPanel>

          <ListBox Grid.Row="1"
                   x:Name="PresetListBox"
                   SelectionMode="Single"
                   HorizontalContentAlignment="Stretch"
                   SelectionChanged="PresetListBox_SelectionChanged"
                   MouseDoubleClick="PresetListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="7,6">
                  <StackPanel>
                    <TextBlock Text="{Binding Description}"
                               FontWeight="SemiBold"
                               Foreground="#1F2933"/>
                    <TextBlock Text="{Binding Summary}"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="#52606D"/>
                    <TextBlock Text="{Binding AliasText}"
                               Margin="0,2,0,0"
                               FontSize="10"
                               Foreground="#7B8794"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="2"
                     x:Name="PresetCountTextBlock"
                     Margin="0,8,0,0"
                     Foreground="#7B8794"
                     FontSize="11"/>

          <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="New Preset"
                    Click="NewPreset_Click"/>
            <Button Grid.Column="2"
                    x:Name="RemovePresetButton"
                    Content="Remove Preset"
                    Click="RemovePreset_Click"
                    Foreground="#A61B1B"/>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="White"
              BorderBrush="#D9E0E7"
              BorderThickness="1"
              CornerRadius="5"
              Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="EditorTitleTextBlock"
                       Text="Preset details"
                       FontSize="15"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="EditorHelpTextBlock"
                       Margin="0,3,0,0"
                       Foreground="#52606D"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="145"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Description"
                       VerticalAlignment="Center"
                       Margin="0,0,12,10"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     x:Name="DescriptionTextBox"
                     Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Search aliases"
                       VerticalAlignment="Center"
                       Margin="0,0,12,10"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
              <TextBox x:Name="AliasesTextBox"/>
              <TextBlock Text="Optional; separate aliases with commas."
                         FontSize="10"
                         Foreground="#7B8794"
                         Margin="0,3,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="Connected load"
                       VerticalAlignment="Center"
                       Margin="0,0,12,10"/>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="KvaTextBox"/>
              <TextBlock Grid.Column="1" Text="kVA"
                         VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="Voltage"
                       VerticalAlignment="Center"
                       Margin="0,0,12,10"/>
            <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="VoltageTextBox"/>
              <TextBlock Grid.Column="1" Text="V"
                         VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="Poles"
                       VerticalAlignment="Center"
                       Margin="0,0,12,10"/>
            <ComboBox Grid.Row="4" Grid.Column="1"
                      x:Name="PolesComboBox"
                      Margin="0,0,0,10"/>

            <TextBlock Grid.Row="5" Grid.Column="0"
                       Text="MCA"
                       VerticalAlignment="Center"
                       Margin="0,0,12,10"/>
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="McaTextBox"/>
              <TextBlock Grid.Column="1" Text="A (optional)"
                         VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <TextBlock Grid.Row="6" Grid.Column="0"
                       Text="Breaker / MOCP"
                       VerticalAlignment="Center"
                       Margin="0,0,12,10"/>
            <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="MocpTextBox"/>
              <TextBlock Grid.Column="1" Text="A"
                         VerticalAlignment="Center" Margin="8,0,8,0"/>
              <Button Grid.Column="2"
                      Content="Suggest"
                      Click="SuggestBreaker_Click"
                      MinWidth="78"/>
            </Grid>

            <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="#F4F7FA"
                    BorderBrush="#D9E0E7"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,4,0,0">
              <TextBlock x:Name="ValidationTextBlock"
                         Text="Select a preset or start a new circuit."
                         Foreground="#52606D"
                         TextWrapping="Wrap"/>
            </Border>
          </Grid>

          <StackPanel Grid.Row="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Margin="0,16,0,0">
            <Button x:Name="SavePresetButton"
                    Content="Save Preset"
                    Click="SavePreset_Click"
                    MinWidth="105"/>
            <Button x:Name="UseCircuitButton"
                    Content="Use Circuit"
                    Click="UseCircuit_Click"
                    IsDefault="True"
                    MinWidth="105"
                    Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button Content="New One-Time Circuit"
                Click="NewOneTime_Click"
                MinWidth="150"/>
        <TextBlock x:Name="CatalogPathTextBlock"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   Foreground="#7B8794"
                   FontSize="10"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="520"/>
      </StackPanel>
      <Button Grid.Column="1"
              Content="Cancel"
              Click="Cancel_Click"
              IsCancel="True"
              MinWidth="85"
              Margin="12,0,0,0"/>
    </Grid>
  </Grid>
</Window>
