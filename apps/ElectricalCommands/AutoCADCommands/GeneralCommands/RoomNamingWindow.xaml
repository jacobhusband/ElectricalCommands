<Window x:Class="ElectricalCommands.RoomNamingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AREALABEL - Name Rooms"
        Width="760"
        Height="540"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F5F7F9"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="14,5"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Name the selected room boundaries"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#1F2933"/>
      <TextBlock Margin="0,4,0,0"
                 Foreground="#52606D"
                 TextWrapping="Wrap"
                 Text="Select a row to highlight its polyline in AutoCAD, then replace every placeholder with the correct room name and number."/>
    </StackPanel>

    <Border Grid.Row="1"
            Background="White"
            BorderBrush="#D9E0E7"
            BorderThickness="1"
            CornerRadius="5"
            Padding="1">
      <DataGrid x:Name="RoomsDataGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#E8EDF2"
                BorderThickness="0"
                RowHeaderWidth="0"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                SelectionChanged="RoomsDataGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Boundary"
                              Binding="{Binding SourceLabel}"
                              IsReadOnly="True"
                              Width="145"/>
          <DataGridTextColumn Header="Square Footage"
                              Binding="{Binding SquareFootageText}"
                              IsReadOnly="True"
                              Width="145"/>
          <DataGridTextColumn Header="Room Name and Number"
                              Binding="{Binding RoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="2"
            Background="#F4F7FA"
            BorderBrush="#D9E0E7"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10"
            Margin="0,12,0,0">
      <StackPanel>
        <TextBlock x:Name="SelectedRoomTextBlock"
                   Foreground="#334E68"
                   FontWeight="SemiBold"/>
        <TextBlock x:Name="StatusTextBlock"
                   Margin="0,3,0,0"
                   Foreground="#52606D"
                   TextWrapping="Wrap"
                   Text="Double-click a Room Name cell to edit it."/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="#7B8794"
                 Text="The base point will be requested after this review."/>
      <Button Grid.Column="1"
              Content="Cancel"
              Click="Cancel_Click"
              IsCancel="True"
              MinWidth="86"
              Margin="12,0,0,0"/>
      <Button Grid.Column="2"
              Content="Save Room Names"
              Click="Save_Click"
              IsDefault="True"
              MinWidth="138"
              Margin="8,0,0,0"/>
    </Grid>
  </Grid>
</Window>
