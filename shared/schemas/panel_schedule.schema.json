{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aciesengineering.com/schemas/panel_schedule.schema.json",
  "title": "PanelSchedule",
  "description": "Schema defining electrical panel schedules, bus configurations, breaker assignments, and phase load balancing for ACIES Engineering.",
  "type": "object",
  "required": [
    "panelName",
    "voltage",
    "phase",
    "wire",
    "mainBusRatingAmps",
    "mainType",
    "circuits"
  ],
  "properties": {
    "panelName": {
      "type": "string",
      "description": "Designation of the panelboard (e.g. LP-1, HPP-2, MDP)"
    },
    "location": {
      "type": "string",
      "description": "Physical room or location in building (e.g. ELEC RM 101)"
    },
    "upstreamFeed": {
      "type": "object",
      "properties": {
        "sourcePanel": { "type": "string" },
        "breakerSizeAmps": { "type": "integer" },
        "feederConductors": { "type": "string", "description": "e.g. 4#3/0, 1#6G in 2\" C" },
        "lengthFt": { "type": "number" },
        "estimatedVoltageDropPercent": { "type": "number" }
      }
    },
    "voltage": {
      "type": "string",
      "enum": ["120/208V", "277/480V", "120/240V", "480V"]
    },
    "phase": {
      "type": "integer",
      "enum": [1, 3]
    },
    "wire": {
      "type": "integer",
      "enum": [3, 4]
    },
    "mainBusRatingAmps": {
      "type": "integer",
      "description": "Busbar ampacity rating (e.g. 100, 225, 400, 800, 1200)"
    },
    "mainType": {
      "type": "string",
      "enum": ["MCB", "MLO"],
      "description": "Main Circuit Breaker (MCB) or Main Lugs Only (MLO)"
    },
    "mainBreakerAmps": {
      "type": ["integer", "null"],
      "description": "Trip rating if MCB"
    },
    "enclosureNema": {
      "type": "string",
      "default": "NEMA 1"
    },
    "shortCircuitCurrentRatingAIC": {
      "type": "integer",
      "description": "Short circuit withstand in RMS symmetrical amperes (e.g. 10000, 22000, 65000)"
    },
    "circuits": {
      "type": "array",
      "description": "List of circuit poles in sequential position order (1, 2, 3...)",
      "items": {
        "$ref": "#/$defs/CircuitPole"
      }
    },
    "loadSummary": {
      "type": "object",
      "properties": {
        "phaseAConnectedVA": { "type": "number" },
        "phaseBConnectedVA": { "type": "number" },
        "phaseCConnectedVA": { "type": "number" },
        "totalConnectedVA": { "type": "number" },
        "totalConnectedAmps": { "type": "number" },
        "phaseADemandVA": { "type": "number" },
        "phaseBDemandVA": { "type": "number" },
        "phaseCDemandVA": { "type": "number" },
        "totalDemandVA": { "type": "number" },
        "totalDemandAmps": { "type": "number" },
        "unbalancePercentage": {
          "type": "number",
          "description": "Max deviation between phase demand loads / average phase demand load"
        }
      }
    },
    "oleHandle": {
      "type": "string",
      "description": "AutoCAD CAD entity handle of the Ole2Frame in DWG"
    },
    "drawingPath": {
      "type": "string",
      "description": "File path to the hosting DWG drawing"
    },
    "excelWorkbookPath": {
      "type": "string",
      "description": "File path to the source Excel (.xlsx) workbook"
    },
    "validationStatus": {
      "type": "string",
      "enum": ["VALID", "WARNINGS", "ERRORS"],
      "default": "VALID"
    },
    "diagnostics": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "$defs": {
    "CircuitPole": {
      "type": "object",
      "required": ["circuitNumber", "phasePole", "loadDescription", "loadType", "breakerAmps", "poles"],
      "properties": {
        "circuitNumber": { "type": "integer" },
        "phasePole": { "type": "string", "enum": ["A", "B", "C"] },
        "loadDescription": { "type": "string" },
        "loadType": {
          "type": "string",
          "enum": [
            "LIGHTING_CONTINUOUS",
            "RECEPTACLE_NON_CONTINUOUS",
            "MOTOR",
            "HVAC_CONTINUOUS",
            "KITCHEN_EQUIPMENT",
            "ELECTRIC_HEATING",
            "SPARE",
            "SPACE"
          ]
        },
        "breakerAmps": { "type": "integer" },
        "poles": { "type": "integer", "enum": [1, 2, 3] },
        "wireGauge": { "type": "string", "default": "#12 AWG" },
        "conduitSize": { "type": "string", "default": "3/4\" C" },
        "connectedVA": { "type": "number" },
        "demandFactorPercent": { "type": "number", "default": 100 },
        "demandVA": { "type": "number" },
        "roomOrZone": { "type": "string" },
        "connectedDevices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cadHandle": { "type": "string" },
              "blockName": { "type": "string" },
              "deviceType": { "type": "string" },
              "quantity": { "type": "integer" },
              "unitVA": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
