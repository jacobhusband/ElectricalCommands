<Window x:Class="ElectricalCommands.ViewportFromRegionOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Viewport from Region"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Choose the destination sheet and viewport scale."
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Sheet / Layout"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <ComboBox Grid.Column="1"
                      x:Name="LayoutComboBox"
                      MinHeight="28"
                      VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Scale"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <ComboBox Grid.Column="1"
                      x:Name="ScaleComboBox"
                      MinHeight="28"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ScaleComboBox_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="3"
              x:Name="CustomScaleGrid"
              Visibility="Collapsed"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Custom scale"
                       VerticalAlignment="Top"
                       Margin="0,5,12,0"/>
            <StackPanel Grid.Column="1">
                <TextBox x:Name="CustomScaleTextBox"
                         MinHeight="28"
                         VerticalContentAlignment="Center"
                         TextChanged="CustomScaleTextBox_TextChanged"/>
                <TextBlock Text="Examples: 1&quot; = 10'-0&quot;, 1:120, or 1/120"
                           Foreground="#666666"
                           FontSize="11"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="RegionSizeTextBlock"
                   Foreground="#666666"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="5"
                Background="#F4F6F8"
                BorderBrush="#D7DCE1"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10">
            <TextBlock x:Name="ScaleSummaryTextBlock"
                       TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CreateButton"
                    Content="Create Viewport"
                    Click="Create_Click"
                    IsDefault="True"
                    MinWidth="120"
                    Padding="12,6"/>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    MinWidth="80"
                    Padding="12,6"
                    Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
