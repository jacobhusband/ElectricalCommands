<Window x:Class="ElectricalCommands.OpenDrawingLayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Drawing Layer Manager"
        Height="700"
        Width="1000"
        MinHeight="560"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Freeze or thaw layers in drawings that are currently open"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       Text="Choose the open drawings to update, select one or more layers, and assign a planned action. Changes are left unsaved for review."/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Open drawings" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="DrawingListBox"
                         Grid.Column="0"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="3,2"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      ToolTip="{Binding FullName}"
                                      Click="DrawingSelectionChanged">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                    <Button Content="Select all" Click="SelectAllDrawings_Click" Padding="10,5" MinWidth="92"/>
                    <Button Content="Select none" Click="SelectNoDrawings_Click" Padding="10,5" MinWidth="92" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Filter layers:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     TextChanged="SearchTextBox_TextChanged"
                     Padding="6,4"/>
            <TextBlock Grid.Column="2"
                       Margin="12,0,0,0"
                       Foreground="#666666"
                       VerticalAlignment="Center"
                       Text="Use Ctrl or Shift to select multiple layers."/>
            <Button Grid.Column="3" Content="Clear planned actions" Click="ClearAllActions_Click" Padding="10,5"/>
        </Grid>

        <DataGrid x:Name="LayerGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Layer" Binding="{Binding Name}" Width="2.2*"/>
                <DataGridTextColumn Header="Present in" Binding="{Binding PresenceSummary}" Width="0.8*"/>
                <DataGridTextColumn Header="Existing state" Binding="{Binding StateSummary}" Width="1.35*"/>
                <DataGridTextColumn Header="Current layer" Binding="{Binding CurrentSummary}" Width="1.0*"/>
                <DataGridTextColumn Header="Planned action" Binding="{Binding PlannedAction}" Width="1.0*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Freeze selected" Click="FreezeSelected_Click" Padding="14,7"/>
            <Button Grid.Column="1" Content="Thaw selected" Click="ThawSelected_Click" Padding="14,7" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="Leave untouched" Click="LeaveSelectedUntouched_Click" Padding="14,7" Margin="8,0,0,0"/>
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="3"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="#555555"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <CheckBox x:Name="SaveDrawingsCheckBox"
                          IsChecked="True"
                          FontWeight="SemiBold"
                          Content="Save selected drawings after applying"/>
                <TextBlock Margin="0,4,0,0"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Text="If a layer being frozen is current, a new ACIES-FREEZE-FALLBACK layer will be created and made current first."/>
            </StackPanel>
            <Button x:Name="ApplyButton"
                    Grid.Column="1"
                    Content="Apply"
                    Click="Apply_Click"
                    IsDefault="True"
                    Padding="16,7"
                    MinWidth="90"
                    Margin="12,0,0,0"/>
            <Button Grid.Column="2"
                    Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Padding="16,7"
                    MinWidth="90"
                    Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
