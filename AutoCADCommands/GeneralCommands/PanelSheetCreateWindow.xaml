<Window x:Class="ElectricalCommands.PanelSheetCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Panel Worksheet"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F7F9"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#52606D"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,8"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#334E68"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="14,5"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D9E0E7"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="14,12,14,4"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="16">
    <TextBlock Text="Create a new panel worksheet"
               FontSize="18"
               FontWeight="SemiBold"
               Foreground="#1F2933"/>
    <TextBlock x:Name="SubtitleText"
               Margin="0,4,0,12"
               Foreground="#52606D"
               TextWrapping="Wrap"/>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Worksheet" Style="{StaticResource SectionTitle}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="New sheet name" Style="{StaticResource FieldLabel}"/>
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="SheetNameBox"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Template sheet" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TemplateBox"
                    SelectionChanged="TemplateBox_SelectionChanged"
                    ToolTip="The new sheet is a copy of this sheet. Its header values below start from the template's, and any circuits it holds are cleared."/>
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Panel information" Style="{StaticResource SectionTitle}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Voltage" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="0" Grid.Column="1" x:Name="VoltageBox" IsEditable="True"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="Wires" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="0" Grid.Column="4" x:Name="WiresBox"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Bus rating" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="1" Grid.Column="1" x:Name="BusRatingBox" IsEditable="True"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="Phase" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="1" Grid.Column="4" x:Name="PhaseBox"
                    SelectionChanged="PhaseBox_SelectionChanged"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Main" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MainBox" IsEditable="True"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="Type" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="2" Grid.Column="4" x:Name="TypeBox" IsEditable="True"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Mounting" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="3" Grid.Column="1" x:Name="MountingBox" IsEditable="True"/>
          <TextBlock Grid.Row="3" Grid.Column="3" Text="AIC rating" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="3" Grid.Column="4" x:Name="AicBox" IsEditable="True"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Condition" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ConditionBox"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Circuit breakers" Style="{StaticResource SectionTitle}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Number of breakers" Style="{StaticResource FieldLabel}"/>
          <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CircuitCountBox" IsEditable="True"
                    ToolTip="Circuit positions in the panel. Rows beyond this number are hidden on the new sheet."/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Breaker phases" Style="{StaticResource FieldLabel}"/>
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="BreakerPhasesBox"
                   TextChanged="BreakerPhasesBox_TextChanged"
                   ToolTip="Phase letters written down the PHASE column, one per row of two circuits (1/2, 3/4, ...), repeating. For a 3-phase panel A, B, C gives rows A, B, C, A, B, C..."/>
        </Grid>
        <TextBlock x:Name="CircuitHintText"
                   Margin="0,-2,0,8"
                   Foreground="#7B8794"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="StatusText"
               Foreground="Firebrick"
               TextWrapping="Wrap"
               MinHeight="18"/>

    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="#7B8794"
                 Text="Nothing is changed in the workbook until you click Create."/>
      <Button Grid.Column="1"
              Content="Cancel"
              IsCancel="True"
              MinWidth="86"
              Margin="12,0,0,0"
              Click="Cancel_Click"/>
      <Button Grid.Column="2"
              Content="Create Worksheet"
              IsDefault="True"
              MinWidth="130"
              Margin="8,0,0,0"
              Click="Create_Click"/>
    </Grid>
  </StackPanel>
</Window>
